# Copy to .env and fill in. Real environment variables override this file.
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example          # public https address (used in emails + CSRF checks)
TRUST_PROXY=cloudflare                        # cloudflare = trust CF-Connecting-IP (firewall origin to Cloudflare IPs); 1 = trust last X-Forwarded-For hop (nginx/Render); empty = direct
DATA_DIR=./data                               # database, private videos, PDFs, images — back this up
APP_SECRET=                                   # 32+ random characters (auto-generated if empty)
SESSION_DAYS=30
PLAYBACK_TOKEN_TTL=600                        # seconds a playback grant lasts; the player renews it automatically. Shorter = revocation bites sooner on Cloudflare

# Email (verification, password reset, approval)
EMAIL_PROVIDER=resend                         # resend | console (console = test mode, emails shown in dashboard)
EMAIL_FROM="Mathematics Course <lessons@your-domain.example>"
RESEND_API_KEY=

# Video: cloudflare (recommended, adaptive streaming) or local (private files on this server)
VIDEO_PROVIDER=cloudflare
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=                          # token with Stream:Edit permission
CF_STREAM_CUSTOMER_CODE=                      # from https://customer-<CODE>.cloudflarestream.com
CF_STREAM_KEY_ID=                             # from POST /accounts/{id}/stream/keys  -> result.id
CF_STREAM_KEY_PEM=                            # ... -> result.pem (base64 string, paste as-is)
MAX_VIDEO_MB=4096                             # local provider only
